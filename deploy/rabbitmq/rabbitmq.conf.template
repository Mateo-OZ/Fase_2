# RabbitMQ de DFSha: solo AMQP sobre TLS mutuo (puerto 5671), sin puerto en claro.
listeners.tcp = none
listeners.ssl.default = 5671
ssl_options.cacertfile = __CERT_DIR__/ca.crt
ssl_options.certfile   = __CERT_DIR__/rabbitmq.crt
ssl_options.keyfile    = __CERT_DIR__/rabbitmq.key
ssl_options.verify     = verify_peer
ssl_options.fail_if_no_peer_cert = true
ssl_options.versions.1 = tlsv1.3
ssl_options.versions.2 = tlsv1.2
default_user = dfsha
default_pass = __MQ_PASSWORD__
loopback_users = none
