# Inventario de la VPC de AWS (IPs privadas fijas asignadas al lanzar las EC2,
# ver deploy/aws/03-instances.sh). Subred privada 10.20.2.0/24.
CTRL1_HOST=10.20.2.11     # meta1 + gateway1 + auth
CTRL2_HOST=10.20.2.12     # meta2 + gateway2
CTRL3_HOST=10.20.2.13     # meta3 + RabbitMQ + worker1 + worker2
DN1_HOST=10.20.2.21
DN2_HOST=10.20.2.22
DN3_HOST=10.20.2.23
DN4_HOST=10.20.2.24
GATEWAY_NAME=dfs.internal # nombre que usa el cliente (DNS privado -> NLB)
NLB_IP=10.20.2.100        # IP privada fija del NLB interno
META_PORT=7100
